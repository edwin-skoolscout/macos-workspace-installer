# macOS only: Colima runtime, Docker CLI plugins, Stripe CLI, GUI apps
# (the stripe tap formula has an unsatisfied requirement on Linux; use Stripe's apt repo there)
tap "stripe/stripe-cli"

brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-buildx"
brew "stripe/stripe-cli/stripe"

cask "ghostty"
cask "visual-studio-code"
cask "google-chrome"
cask "postman"
cask "figma"
